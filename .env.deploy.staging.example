# GCP target
GCP_PROJECT_ID=your-gcp-project
GCP_REGION=europe-west1
K8S_NAMESPACE=preconversion-staging
K8S_CLUSTER=your-gke-cluster
PRECONV_GCP_SERVICE_ACCOUNT=preconversion-runtime@your-gcp-project.iam.gserviceaccount.com
PRECONV_INGRESS_HOST=
PRECONV_INGRESS_STATIC_IP_NAME=vet-claims-api-staging-ip
PRECONV_MANAGED_CERT_NAME=
PRECONV_PRE_SHARED_CERT_NAME=vet-claims-api-staging-ip-cert
PRECONV_TLS_SECRET_NAME=
PRECONV_DISABLE_HTTP=false
# Optional shared-Ingress route. The Service must exist in K8S_NAMESPACE and
# expose this unchanged path on the configured Service port.
PRECONV_TERMINOLOGY_INGRESS_ENABLED=false
PRECONV_TERMINOLOGY_INGRESS_SERVICE_NAME=terminology-api
PRECONV_TERMINOLOGY_INGRESS_SERVICE_PORT=8080


# Container image
# Note: the internal prefix "preconvert" is still used in GCP resources (Firestore, PubSub, GCS) for historical reasons.
# Externally, Docker images, SDKs, and docs use "dataconv". Both names refer to the same software.
DOCKER_IMAGE_NAME=dataconv-api
DOCKER_IMAGE_TAG=staging-latest
ARTIFACT_REGISTRY_REPO=preconversion

# Runtime profile
NODE_ENV=staging
# Dataspace identifier served by this instance (for example: globaldatacare, procuredata, animal).
# Used as the slug in GCP resource names (Firestore, PubSub, GCS) when not explicitly overridden.
PRECONV_DATASPACE_ID=animal

# Internal container port. Cloud Run injects it automatically; in GKE this is the value in use.
# Do not use LOCAL_PORT or DOCKER_PORT in cloud deployments: they are only for local execution.
PORT=8080
HOST_INTERNAL_IP=0.0.0.0
WORKER_REPLICAS=1
API_MAX_SURGE=0
API_MAX_UNAVAILABLE=100%
WORKER_MAX_SURGE=0
WORKER_MAX_UNAVAILABLE=100%
HPA_MIN_REPLICAS=1
HPA_MAX_REPLICAS=3

DB_PROVIDER=firestore
SEARCH_PROVIDER=postgresql
QUEUE_PROVIDER=pubsub
STORAGE_PROVIDER=gcs
NETWORK_MODE=test-network

# GCS artifacts / uploads
GCS_BUCKET_NAME=your-preconversion-staging-bucket
POSTGRES_DSN=postgresql://user:password@host:5432/dbname?sslmode=require
POSTGRES_SEARCH_TABLE=resource_search_index

# Optional overrides. If omitted, runtime derives:
# staging-preconvert-animal-configs
# staging-preconvert-animal-jobs
# staging-preconvert-animal-subject-links
# staging-preconvert-animal-jobs-worker
# staging-preconvert-animal
# PRECONV_FIRESTORE_CONFIG_COLLECTION=
# PRECONV_FIRESTORE_JOB_COLLECTION=
# PRECONV_FIRESTORE_SUBJECT_LINK_COLLECTION=
# PRECONV_PUBSUB_TOPIC_ID=
# PRECONV_PUBSUB_SUBSCRIPTION_ID=
# PRECONV_GCS_PREFIX=

# Confidential external identifier -> twin UUID link. Generate a 32-byte base64url key.
SUBJECT_LINK_PROTECTION_KEY=
SUBJECT_LINK_KEY_VERSION=v1
PRECONV_ICA_BASE_URL=https://animal-ica-st.antifraud.online
PRECONV_ICA_API_KEY=
PRECONV_ICA_TIMEOUT_SECONDS=15

# Optional proposal-only clinical coding. Both URLs are required to enable it.
PRECONV_TERMINOLOGY_BASE_URL=
PRECONV_TERMINOLOGY_TOKEN=
PRECONV_TERMINOLOGY_TIMEOUT_SECONDS=15
PRECONV_CODING_MODEL_BASE_URL=
# For a private Cloud Run/GKE model service, prefer audience credentials over a static token.
PRECONV_CODING_MODEL_AUDIENCE=
PRECONV_CODING_MODEL_TOKEN=
PRECONV_CODING_MODEL_ID=
PRECONV_CODING_MODEL_TIMEOUT_SECONDS=30

# Defaults for generated DIDComm envelope
PRECONV_DEFAULT_ISSUER_DID=did:web:globaldatacare.es:employee:preconversion
PRECONV_DEFAULT_AUDIENCE_DID=did:web:globaldatacare.es
PRECONV_DEFAULT_SUBJECT_DID_PREFIX=did:web:globaldatacare.es
PRECONV_DEFAULT_SPECIES_FHIR_FILE=./configs/fhir-target-species.template.editable.json

# Auth profile for DIDComm/FAPI envelope
# parse-only (internal demo only) | verify-id-token | verify-vp-token | verify-both
PRECONV_AUTH_MODE=verify-id-token
# Demo mode: bypass signature verification in /exchange and Bearer enforcement on uploads (false in production)
DEMO_MODE=false
EXCHANGE_ALLOW_INSECURE_ASSERTIONS=false
EXCHANGE_OIDC_ISSUER=https://securetoken.google.com/your-firebase-project
EXCHANGE_OIDC_AUDIENCE=your-firebase-project
# Generate an independent high-entropy secret; do not reuse the subject-link protection key.
EXCHANGE_SESSION_TOKEN_SECRET=
# Exact tenant GW trust. The JSON binding prevents a valid issuer for one tenant
# from being exchanged on another tenant route.
SMART_GW_ALLOWED_ISSUERS=did:web:gateway.example:tenant:path
SMART_GW_EXPECTED_AUDIENCES=did:web:gateway.example:tenant:path
SMART_GW_ISSUER_TENANT_BINDINGS={"did:web:gateway.example:tenant:path":"CA-BC-7654321"}
SMART_GW_DID_CACHE_TTL_SECONDS=300
SMART_GW_HTTP_TIMEOUT_SECONDS=5
SMART_RESEARCH_AUTH_REQUIRED_IN_DEMO=false
# Exception-only profile for a non-confidential device, such as a desktop app.
# This enables api_key_profile=api-key-exception.v1 and is separate from any organization-controller API key mode.
LOCAL_EXCHANGE_ALLOW_API_KEY_EXCEPTION=true
# Optional comma-separated revocation/disable lists
PRECONV_AUTH_DISABLED_SUBJECTS=
PRECONV_AUTH_DISABLED_DEVICES=
# Job response retention (seconds) for `_upload-response` terminal states
PRECONV_JOB_RESULT_TTL_SECONDS=300
# Cron schedule for global cleanup job (all tenants)
PRECONV_CLEANUP_SCHEDULE="*/5 * * * *"
