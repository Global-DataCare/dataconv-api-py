# GCP target
GCP_PROJECT_ID=your-gcp-project
GCP_REGION=europe-west1
K8S_NAMESPACE=preconversion
K8S_CLUSTER=your-gke-cluster
PRECONV_GCP_SERVICE_ACCOUNT=preconversion-runtime@your-gcp-project.iam.gserviceaccount.com
PRECONV_INGRESS_HOST=vet-claims-api.example.globaldatacare.es
PRECONV_INGRESS_STATIC_IP_NAME=vet-claims-api-prod-ip
PRECONV_MANAGED_CERT_NAME=vet-claims-api-prod-cert
PRECONV_PRE_SHARED_CERT_NAME=
PRECONV_TLS_SECRET_NAME=
PRECONV_DISABLE_HTTP=false


# Container image
# Nota: el prefijo interno "preconvert" se usa en recursos GCP (Firestore, PubSub, GCS) por razones históricas;
# pero hacia afuera (imagen Docker, SDK) usamos "dataconv". Ambos nombres son el mismo software.
DOCKER_IMAGE_NAME=dataconv-api
DOCKER_IMAGE_TAG=latest
ARTIFACT_REGISTRY_REPO=preconversion

# Runtime profile (GKE production)
NODE_ENV=production
# Identificador del dataspace que sirve esta instancia (ej: globaldatacare, procuredata, animal).
# Se usa como slug en nombres de recursos GCP (Firestore, PubSub, GCS) cuando no se definen explícitamente.
PRECONV_DATASPACE_ID=globaldatacare

# Puerto interno del contenedor. Cloud Run lo inyecta automáticamente; en GKE se usa este valor.
# No usar LOCAL_PORT/DOCKER_PORT en despliegues cloud: sólo aplican para ejecución local.
PORT=8080
HOST_INTERNAL_IP=0.0.0.0
API_REPLICAS=2
WORKER_REPLICAS=2
API_MAX_SURGE=25%
API_MAX_UNAVAILABLE=25%
WORKER_MAX_SURGE=25%
WORKER_MAX_UNAVAILABLE=25%
HPA_MIN_REPLICAS=2
HPA_MAX_REPLICAS=10

DB_PROVIDER=firestore
SEARCH_PROVIDER=postgresql
QUEUE_PROVIDER=pubsub
STORAGE_PROVIDER=gcs

# GCS artifacts / uploads
GCS_BUCKET_NAME=your-preconversion-bucket
POSTGRES_DSN=postgresql://user:password@host:5432/dbname?sslmode=require
POSTGRES_SEARCH_TABLE=resource_search_index

# Optional overrides. If omitted, runtime derives:
# prod-preconvert-animal-configs
# prod-preconvert-animal-jobs
# prod-preconvert-animal-jobs-worker
# prod-preconvert-animal
# PRECONV_FIRESTORE_CONFIG_COLLECTION=
# PRECONV_FIRESTORE_JOB_COLLECTION=
# PRECONV_PUBSUB_TOPIC_ID=
# PRECONV_PUBSUB_SUBSCRIPTION_ID=
# PRECONV_GCS_PREFIX=

# Defaults for generated DIDComm envelope
PRECONV_DEFAULT_ISSUER_DID=did:web:globaldatacare.es:employee:preconversion
PRECONV_DEFAULT_AUDIENCE_DID=did:web:globaldatacare.es
PRECONV_DEFAULT_SUBJECT_DID_PREFIX=did:web:globaldatacare.es
PRECONV_DEFAULT_SPECIES_FHIR_FILE=./configs/fhir-target-species.template.editable.json

# Auth profile for DIDComm/FAPI envelope
# parse-only (solo demo interna) | verify-id-token | verify-vp-token | verify-both
PRECONV_AUTH_MODE=verify-id-token
# Modo demo: bypass de verificación de firmas en /exchange y Bearer en uploads (false en producción)
DEMO_MODE=false
# Optional comma-separated revocation/disable lists
PRECONV_AUTH_DISABLED_SUBJECTS=
PRECONV_AUTH_DISABLED_DEVICES=
# Job response retention (seconds) for `_upload-response` terminal states
PRECONV_JOB_RESULT_TTL_SECONDS=300
# Cron schedule for global cleanup job (all tenants)
PRECONV_CLEANUP_SCHEDULE="*/5 * * * *"
