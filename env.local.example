# Runtime
NODE_ENV=development
# Dataspace identifier served by this instance (for example: globaldatacare, procuredata, animal).
# Used as the slug in GCP resource names (Firestore, PubSub, GCS) when not explicitly overridden.
PRECONV_DATASPACE_ID=animal
LOCAL_PORT=3320
DOCKER_PORT=8082
HOST_INTERNAL_IP=0.0.0.0

# Providers (local quick start)
DB_PROVIDER=fs
QUEUE_PROVIDER=fs
STORAGE_PROVIDER=fs
PRECONV_LOCAL_DATA_DIR=./runtime-data

# Defaults for generated DIDComm envelope
PRECONV_DEFAULT_ISSUER_DID=did:web:globaldatacare.es:employee:preconversion
PRECONV_DEFAULT_AUDIENCE_DID=did:web:globaldatacare.es
PRECONV_DEFAULT_SUBJECT_DID_PREFIX=did:web:globaldatacare.es
PRECONV_DEFAULT_SPECIES_FHIR_FILE=./configs/fhir-target-species.template.editable.json

# CSV of jurisdictions supported by this instance. Use '*' to allow any.
SUPPORTED_JURISDICTIONS=ES

# CSV of sectors supported by this instance. Use '*' to allow any.
SUPPORTED_SECTORS=health-care,animal-care,onehealth-care,onehealth-research,onehealth-insurance

# Auth profile for DIDComm/FAPI envelope
# DEMO_MODE=true: demo mode without strict Bearer validation from /exchange
# DEMO_MODE=false: production mode requiring a Bearer token issued by /exchange
DEMO_MODE=true

# Exchange token and session configuration by environment
# Enable API key mode for quick demos. Keep false in production.
EXCHANGE_ALLOW_API_KEY=false
# Explicit exceptional profile for desktop or non-confidential clients in local and staging.
# Keep false in production.
EXCHANGE_ALLOW_API_KEY_EXCEPTION=true
# CSV list of valid API keys when EXCHANGE_ALLOW_API_KEY=true
EXCHANGE_API_KEYS=
# Optional default values for API key mode when not supplied in the request
EXCHANGE_API_KEY_SUBJECT_DEFAULT=
EXCHANGE_API_KEY_ORG_DEFAULT=
# Session token settings issued by /exchange
EXCHANGE_SESSION_TOKEN_SECRET=dev-session-secret-change-me
EXCHANGE_SESSION_TOKEN_TTL_SECONDS=900
# Optional OIDC validation controls
EXCHANGE_OIDC_ISSUER=
EXCHANGE_OIDC_AUDIENCE=
# CSV list of allowed issuers (supports wildcard '*'). If empty, secure defaults are used:
# - https://accounts.google.com
# - https://login.microsoftonline.com/*/v2.0
# - https://securetoken.google.com/*
EXCHANGE_OIDC_ALLOWED_ISSUERS=
# CSV list of allowed audiences (client IDs). If empty, uses EXCHANGE_OIDC_AUDIENCE when present.
EXCHANGE_OIDC_ALLOWED_AUDIENCES=
# JWKS cache TTL in seconds
EXCHANGE_OIDC_JWKS_CACHE_TTL_SECONDS=3600
# Recommended Google and Microsoft example for direct OIDC tokens:
# EXCHANGE_OIDC_ALLOWED_ISSUERS=https://accounts.google.com,https://login.microsoftonline.com/*/v2.0
# EXCHANGE_OIDC_ALLOWED_AUDIENCES=<GOOGLE_CLIENT_ID>,<AZURE_APP_CLIENT_ID>
# Firebase example when using Firebase Auth as the broker:
# EXCHANGE_OIDC_ALLOWED_ISSUERS=https://securetoken.google.com/<FIREBASE_PROJECT_ID>
# EXCHANGE_OIDC_ALLOWED_AUDIENCES=<FIREBASE_PROJECT_ID>
# Default scopes allowed during token exchange
EXCHANGE_DEFAULT_ALLOWED_SCOPES=dataconv.upload
# Local test environments only
EXCHANGE_ALLOW_INSECURE_ASSERTIONS=true

# Optional comma-separated revocation/disable lists
PRECONV_AUTH_DISABLED_SUBJECTS=
PRECONV_AUTH_DISABLED_DEVICES=
# Job response retention (seconds) for `_upload-response` terminal states
PRECONV_JOB_RESULT_TTL_SECONDS=3600
